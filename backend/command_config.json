{
  "config_version": 2,
  "_comment": "Single source of truth for the Palette NEAT SDK Demo command layer: the real YOLO class sets of the two model archives in assets/models, the Korean and English aliases, the supported actions, the intent phrases and the Qwen3 few-shot examples. Loaded and validated by backend/command_config.py.",
  "provenance": {
    "class_discovery": "num_classes from each archive's own 0_boxdecoder.json, names from assets/coco_labels.txt (the labels file the vision process loads)",
    "same_class_sets": true
  },
  "matching": {
    "_comment": "Deterministic phrase matching only (spec sections 17, 24, 25): longest valid phrase wins over non-overlapping spans, scanned left to right. No fuzzy, semantic or nearest-class matching anywhere.",
    "longest_phrase_wins": true,
    "ascii_word_boundary": true,
    "ambiguous_distinct_matches": "unknown",
    "hangul": {
      "_comment": "How Hangul aliases match.  Two or more syllables match as a plain substring, so a trailing particle needs no handling and none is stripped.  A one-syllable noun alias matches only when it is bounded by non-Hangul, is not preceded by a counter or a digit, and - for the words in particle_required - is followed by one of the particles.  이랑/하고/과/와/랑 join two classes in one command (사람과 컵만).",
      "short_alias_max_syllables": 1,
      "particles": [
        "에서",
        "으로",
        "를",
        "을",
        "이",
        "가",
        "은",
        "는",
        "만",
        "도",
        "에",
        "의",
        "로",
        "이랑",
        "하고",
        "과",
        "와",
        "랑"
      ],
      "particle_required": [
        "새",
