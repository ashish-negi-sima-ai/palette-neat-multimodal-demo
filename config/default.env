# Palette NEAT SDK Demo (drone_seminar_neat) - site configuration, sourced by run.sh and every project script.
# Override in config/local.env (sourced after this file). No project path lives here:
# the project root is always resolved from the script location.

# ---- GenAI model storage (on the Modalix DevKit) --------------------------------------
# The ONE place the external model location is configured. Only two directories are
# needed under it: whisper-medium-a16w8/ and Qwen3-0.6B-Autoround-a16w4/.
# (The YOLO archives are inside this project: assets/models/.)
MODEL_ROOT="${MODEL_ROOT:-/media/nvme/llima/models}"

# ---- network / machines ---------------------------------------------------------
# The Modalix DevKit and the notebook (the machine running Neat Insight).
DEVKIT_IP="${DEVKIT_IP:-10.42.0.203}"
DEVKIT_HOST="${DEVKIT_HOST:-${DEVKIT_IP}}"
DEVKIT_USER="${DEVKIT_USER:-sima}"
HOST_IP="${HOST_IP:-10.42.0.1}"
# Where Neat Insight runs; the DevKit sends RTP video and metadata there.
INSIGHT_HOST="${INSIGHT_HOST:-${HOST_IP}}"
INSIGHT_API_PORT="${INSIGHT_API_PORT:-9900}"
INSIGHT_VF_PORT="${INSIGHT_VF_PORT:-8081}"

# ---- vision outputs (channel N uses base + N) ------------------------------------
VIDEO_PORT_BASE="${VIDEO_PORT_BASE:-9000}"
METADATA_PORT_BASE="${METADATA_PORT_BASE:-9100}"
# Vision MLA arbiter (loopback, inside the vision process).
ARBITER_PORT="${ARBITER_PORT:-8974}"
# What vision does during a voice MLA lease: drop = cameras and video keep running.
VISION_PAUSE_BEHAVIOUR="${VISION_PAUSE_BEHAVIOUR:-drop}"

# ---- USB cameras (two standard UVC cameras) ----------------------------------------
# Discovered from sysfs + V4L2 at every start (never a hard-coded /dev/videoN) and
# ordered by USB topology, so the mapping stays the same while the cameras stay on
# their USB ports:
#     camera 0 = LEFT  = ch0 = YOLO26m detection
#     camera 1 = RIGHT = ch1 = YOLO26m-seg segmentation
# Optional selectors (empty = automatic). Any of:
#     /dev/videoN   /dev/v4l/by-id/...   /dev/v4l/by-path/...
#     serial:<usb serial>   path:<usb port path, e.g. 1-3.3>   id:<vid:pid>   name:<text>
# List what is attached:  vision-local/build-devkit/drone-seminar-usb-vision --list-cameras
USB_CAMERA0_DEVICE="${USB_CAMERA0_DEVICE:-}"
USB_CAMERA1_DEVICE="${USB_CAMERA1_DEVICE:-}"
# Only consider cameras matching this selector (for boards with more than two cameras).
USB_CAMERA_FILTER="${USB_CAMERA_FILTER:-}"
# auto = MJPG (hardware JPEG decode to NV12) when offered, else YUYV (CPU conversion).
USB_CAMERA_FORMAT="${USB_CAMERA_FORMAT:-auto}"
# Capture modes in preference order. Every candidate is test-streamed on BOTH cameras
# at the same time and the first one both deliver is used, because USB bandwidth is
# only granted when a stream starts: two cameras on one USB 2.0 bus cannot carry two
# 1080p30 MJPEG streams (kernel: "Not enough bandwidth for altsetting").
USB_CAMERA_MODES="${USB_CAMERA_MODES:-1920x1080@30,1920x1080@24,1920x1080@20,1280x720@30,1920x1080@15,1280x720@24,1280x720@20,1280x720@15,960x720@30,640x480@30}"
# Force exactly one mode instead, e.g. MJPG:1280x720@30 (still probed at startup).
USB_CAMERA_MODE="${USB_CAMERA_MODE:-}"

# ---- UI ---------------------------------------------------------------------------
UI_BIND="${UI_BIND:-0.0.0.0}"
UI_PORT="${UI_PORT:-8022}"
# Browser jitter target (ms). 45 is the measured value with reliable video/metadata
# pairing on both streams. Do not change without an A/B measurement.
SYNC_BUFFER_MS="${SYNC_BUFFER_MS:-45}"

# ---- audio ------------------------------------------------------------------------
# The microphone is the browser's (Web Audio, 16 kHz mono upload); the page asks the
# browser for its default input device. MICROPHONE is informational for the checks.
AUDIO_SOURCE="${AUDIO_SOURCE:-browser}"
MICROPHONE="${MICROPHONE:-browser-default}"

# ---- on-device voice runtime (Whisper-medium + Qwen3-0.6B on the MLA) ----------------
VOICE_PORT="${VOICE_PORT:-8983}"
# pyneat (NEAT GenAI Python runtime) environment on the DevKit.
PYNEAT_ENV="${PYNEAT_ENV:-${HOME}/pyneat}"
# 1 = the voice runtime takes the vision MLA lease around every inference.
VOICE_ARBITER="${VOICE_ARBITER:-1}"
