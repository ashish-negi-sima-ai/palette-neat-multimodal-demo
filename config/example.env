# config/example.env - copy to config/local.env and edit for another site.
# Every variable in config/default.env can be set here.
#
# MODEL_ROOT=/media/nvme/llima/models          # holds whisper-medium-a16w8/ and Qwen3-0.6B-Autoround-a16w4/
# DEVKIT_IP=10.42.0.203
# HOST_IP=10.42.0.1                            # the notebook, where Neat Insight runs
# INSIGHT_HOST=10.42.0.1
# VIDEO_PORT_BASE=9000
# METADATA_PORT_BASE=9100
# UI_PORT=8022
# VOICE_PORT=8983
# PYNEAT_ENV=/home/sima/pyneat
#
# USB cameras (empty = automatic, ordered by USB port):
# USB_CAMERA0_DEVICE=serial:D91EAE8F           # LEFT  / ch0 / detection
# USB_CAMERA1_DEVICE=path:1-3.1                # RIGHT / ch1 / segmentation
# USB_CAMERA_FILTER=name:C92                   # only when more than two cameras are attached
# USB_CAMERA_MODE=MJPG:1280x720@30             # force one capture mode
